# ============================================================================
# .env.prod.example — Variables à configurer sur le VPS
#
# Copier ce fichier en .env dans /opt/instram/ sur le VPS :
#   cp .env.prod.example .env
#   nano .env   # remplir les valeurs
#
# NE JAMAIS committer le vrai .env — ce fichier exemple est sans valeurs réelles.
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=instram
POSTGRES_PASSWORD=CHANGER_MOT_DE_PASSE_FORT
POSTGRES_DB=instram_prod

# ── JWT — générer avec : openssl rand -hex 32 ────────────────────────────────
JWT_ACCESS_SECRET=GENERER_AVEC_OPENSSL
JWT_REFRESH_SECRET=GENERER_AVEC_OPENSSL_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs publiques du VPS ────────────────────────────────────────────────────
# Remplacer XXX.XXX.XXX.XXX par l'IP de votre VPS
# Ou par votre domaine si vous en avez un (ex: instram.mg)
CORS_ORIGIN=http://XXX.XXX.XXX.XXX:3000
FRONTEND_URL=http://XXX.XXX.XXX.XXX:3000
NEXT_PUBLIC_API_URL=http://XXX.XXX.XXX.XXX:4000
NEXT_PUBLIC_WS_URL=ws://XXX.XXX.XXX.XXX:4000/ws
TRUSTED_PROXY_IPS=

# ── Email ────────────────────────────────────────────────────────────────────
# Pour la soutenance : brevo (300 emails/jour gratuits, déjà configuré)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=VOTRE_CLE_API_BREVO
SMTP_FROM=InsTRAM <noreply@instram.mg>

# ── SMS ──────────────────────────────────────────────────────────────────────
# Pour la soutenance : stub (les SMS s'affichent dans les logs)
SMS_PROVIDER=stub

# ── Plage de silence nocturne ────────────────────────────────────────────────
SILENCE_START_HOUR=21
SILENCE_END_HOUR=6

# ── QR Code ──────────────────────────────────────────────────────────────────
QR_SECRET=GENERER_AVEC_OPENSSL

# ── Stockage exports ─────────────────────────────────────────────────────────
# local = fichiers sur disque VPS (acceptable pour la soutenance)
STORAGE_PROVIDER=local

# ── Webhook SMS IFTTT (confirmation paiement automatique) ────────────────────
# Secret partagé entre IFTTT et le backend pour sécuriser le webhook
SMS_WEBHOOK_SECRET=GENERER_AVEC_OPENSSL

# ── Mobile Money (optionnel pour la soutenance — laisser vide) ───────────────
MVOLA_BASE_URL=
MVOLA_CLIENT_ID=
MVOLA_CLIENT_SECRET=
MVOLA_WEBHOOK_SECRET=
MVOLA_MERCHANT_NUMBER=
MVOLA_CALLBACK_URL=

ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_TOKEN=
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_NOTIF_URL=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
