DATABASE_URL=postgresql://instram:password@localhost:5432/instram_dev
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------
# SMS Provider — valeur : stub | orange | telma
# 'stub' : logs console, aucun envoi réel (dev/test)
# -----------------------------------------------------------------------
SMS_PROVIDER=stub

# Orange Madagascar SMS (sandbox — ne jamais mettre les clés de production ici)
ORANGE_SMS_URL=https://api.orange.mg/smsmessaging/v1
ORANGE_SMS_KEY=PLACEHOLDER_ORANGE_SMS

# Telma Madagascar SMS (sandbox — ne jamais mettre les clés de production ici)
TELMA_SMS_URL=https://api.telma.net/sms
TELMA_SMS_KEY=PLACEHOLDER_TELMA_SMS

# -----------------------------------------------------------------------
# Fenêtre de silence nocturne VH-02 — heure locale Madagascar (UTC+3)
# Défaut : 21h00 – 06h00
# -----------------------------------------------------------------------
SILENCE_START_HOUR=21
SILENCE_END_HOUR=6

# -----------------------------------------------------------------------
# Paiement Mobile Money (sandbox uniquement — ne jamais mettre les clés prod ici)
# -----------------------------------------------------------------------

# MVola (Telma Madagascar)
MVOLA_BASE_URL=https://devapi.mvola.mg
MVOLA_CLIENT_ID=PLACEHOLDER_MVOLA_CLIENT_ID
MVOLA_CLIENT_SECRET=PLACEHOLDER_MVOLA_CLIENT_SECRET
MVOLA_WEBHOOK_SECRET=PLACEHOLDER_MVOLA_WEBHOOK
MVOLA_MERCHANT_NUMBER=PLACEHOLDER_MVOLA_MERCHANT_NUMBER
MVOLA_CALLBACK_URL=https://api.instram.mg/v1/webhooks/mobile-money/mvola

# Orange Money Madagascar
ORANGE_MONEY_BASE_URL=https://api.sandbox.orange.mg
ORANGE_MONEY_TOKEN=PLACEHOLDER_ORANGE_MONEY_TOKEN
ORANGE_MONEY_WEBHOOK_SECRET=PLACEHOLDER_ORANGE_MONEY_WEBHOOK
ORANGE_MONEY_MERCHANT_KEY=PLACEHOLDER_ORANGE_MONEY_MERCHANT_KEY
ORANGE_MONEY_NOTIF_URL=https://api.instram.mg/v1/webhooks/mobile-money/orange-money
ORANGE_MONEY_RETURN_URL=https://instram.mg/payment/return
ORANGE_MONEY_CANCEL_URL=https://instram.mg/payment/cancel

# -----------------------------------------------------------------------
# QR Code billet (VH-09) — signature HMAC
# -----------------------------------------------------------------------
QR_SECRET=change_me_qr_secret

# -----------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------
# Stockage objet (exports CSV/PDF/XLSX — architecture §2 worker export.generate)
# STORAGE_PROVIDER=local → écriture dans ./exports/ (dev)
# STORAGE_PROVIDER=s3    → AWS S3 (prod)
# Ne jamais mettre les vraies clés AWS ici — utiliser les secrets du CI/CD
# -----------------------------------------------------------------------
STORAGE_PROVIDER=local
S3_BUCKET_NAME=instram-exports
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=PLACEHOLDER_AWS_KEY
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_AWS_SECRET
