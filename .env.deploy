# ============================================================================
# .env — InsTRAM VPS Production
# À placer dans /opt/instram/.env sur le serveur
#
# Valeurs à compléter (marquées TODO) :
#   - POSTGRES_PASSWORD   : choisir un mot de passe fort
#   - XXX.XXX.XXX.XXX     : remplacer par l'IP du VPS
#   - BREVO_API_KEY       : récupérer sur app.brevo.com → Paramètres → Clés API
# ============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=instram
POSTGRES_PASSWORD=TODO_CHANGER_MOT_DE_PASSE_FORT
POSTGRES_DB=instram_prod

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=b8a599d912a3a69940ef94c621d4c2b0ec9c00f618bd79c0e1dcbc1fa98245b9
JWT_REFRESH_SECRET=31ae999df356e2c42e281291e04ca3c1119ba669fc8f5f7342a43fd2e04488dc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs publiques — remplacer XXX.XXX.XXX.XXX par l'IP du VPS ──────────────
CORS_ORIGIN=http://XXX.XXX.XXX.XXX:3000
FRONTEND_URL=http://XXX.XXX.XXX.XXX:3000
NEXT_PUBLIC_API_URL=http://XXX.XXX.XXX.XXX:4000
NEXT_PUBLIC_WS_URL=ws://XXX.XXX.XXX.XXX:4000/ws
TRUSTED_PROXY_IPS=

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=brevo
BREVO_API_KEY=TODO_CLE_API_BREVO
SMTP_FROM=InsTRAM <noreply@instram.mg>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=stub

# ── Plage de silence nocturne ─────────────────────────────────────────────────
SILENCE_START_HOUR=21
SILENCE_END_HOUR=6

# ── QR Code ───────────────────────────────────────────────────────────────────
QR_SECRET=df21fb1639f64464154d462df4f009e43b914e5e814ea3722c11f38d28f9a219

# ── Stockage exports ──────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# URL publique du backend (pour les liens de téléchargement exports)
# Ex: http://XXX.XXX.XXX.XXX:4000
BACKEND_PUBLIC_URL=http://XXX.XXX.XXX.XXX:4000

# ── Webhook SMS IFTTT ─────────────────────────────────────────────────────────
